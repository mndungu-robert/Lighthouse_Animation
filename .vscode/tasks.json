{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build & Run Lighthouse 3D",
            "type": "shell",
            "command": "g++",
            "args": [
                "-g",
                "${workspaceFolder}/main.cpp",
                "-o",
                "${workspaceFolder}/lighthouse.exe",
                "-lfreeglut",
                "-lopengl32",
                "-lglu32",
                "-lgdi32",
                "&&",
                "${workspaceFolder}/lighthouse.exe"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"]
        }
    ]
}